OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=http://localhost:8317/v1
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
OPENAI_MODEL=gpt-5.4-mini

# embedding 可单独走另一家 provider；未配置时会回退到 OPENAI_*。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# 可选：为支持该参数的 provider 指定 embedding 维度
EMBEDDING_DIMENSIONS=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 可选：若 sqlite-vec 无法自动解析原生扩展路径，可显式指定扩展文件绝对路径
SQLITE_VEC_EXTENSION_PATH=
# 可选：json_cache / sqlite_vec
GENERATION_VECTOR_BACKEND=json_cache
GENERATION_DATA_DIR=.data
GENERATION_REVIEW_REWRITE_MIN_SEVERITY=critical
GENERATION_REVIEW_MAX_REWRITE_COUNT=2
GENERATION_REVIEW_CONSISTENCY_MIN_SCORE=60
GENERATION_REVIEW_CONTINUITY_MIN_SCORE=60
GENERATION_REVIEW_READER_PULL_MIN_SCORE=55
GENERATION_POLISH_FAIL_BLOCK_READY=true
PROMPT_ENABLE_CORE_CONSTRAINTS=true
PROMPT_ENABLE_ANTI_AI=true
PROMPT_ENABLE_STRAND_WEAVE=true
PROMPT_ENABLE_COOL_POINTS=false
PROMPT_ENABLE_NO_POISON=true

# 本地离线验证可临时使用 local-hash，正式检索建议仍使用真实 embedding 模型
