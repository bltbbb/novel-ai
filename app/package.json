{
  "name": "ai-novel-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ai": "playwright test e2e/ai-continuation.spec.ts --reporter=line --workers=1",
    "test:e2e:export": "playwright test e2e/export.spec.ts --reporter=line --workers=1",
    "test:e2e:records": "playwright test e2e/records-foreshadow.spec.ts e2e/inspiration-entry.spec.ts --reporter=line --workers=1",
    "test:e2e:inspiration": "playwright test e2e/inspiration-entry.spec.ts --reporter=line --workers=1",
    "test:e2e:archive": "playwright test e2e/archive-import.spec.ts --reporter=line --workers=1",
    "test:e2e:graph": "playwright test e2e/graph-template.spec.ts --reporter=line --workers=1",
    "test:e2e:inspector": "playwright test e2e/inspector-context.spec.ts --reporter=line --workers=1",
    "test:e2e:generation": "playwright test e2e/generation-maintenance.spec.ts e2e/generation-retrieval.spec.ts e2e/volume-plan-reconcile.spec.ts --reporter=line --workers=1",
    "test:e2e:planning": "playwright test e2e/volume-plan-reconcile.spec.ts --reporter=line --workers=1",
    "test:e2e:retrieval": "playwright test e2e/generation-retrieval.spec.ts --reporter=line --workers=1"
  },
  "dependencies": {
    "@tiptap/extension-placeholder": "^2.11.0",
    "@tiptap/pm": "^2.11.0",
    "@tiptap/react": "^2.11.0",
    "@tiptap/starter-kit": "^2.11.0",
    "@tiptap/suggestion": "^2.11.0",
    "dexie": "^4.0.0",
    "lucide-react": "^0.546.0",
    "openai": "^4.80.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.0",
    "vite": "^6.2.0"
  }
}
